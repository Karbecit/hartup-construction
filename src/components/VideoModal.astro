<div
  id="video-modal"
  class="video-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Design video"
  hidden
>
  <button type="button" class="video-modal__close" aria-label="Close video">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" />
    </svg>
  </button>
  <div class="video-modal__backdrop" data-video-close></div>
  <div class="video-modal__content">
    <iframe
      class="video-modal__iframe"
      src=""
      title=""
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</div>

<style is:global>
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 1001;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .video-modal[hidden] {
    display: none;
  }

  .video-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    cursor: pointer;
  }

  .video-modal__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    color: #ffffff;
    cursor: pointer;
    transition: background 0.2s;
  }

  .video-modal__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .video-modal__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .video-modal__content {
    position: relative;
    z-index: 1;
    width: min(960px, 95vw);
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .video-modal__iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  function initVideoModal() {
    const modal = document.getElementById('video-modal');
    if (!modal || modal.dataset.initialized) return;
    modal.dataset.initialized = 'true';

    const iframe = modal.querySelector('.video-modal__iframe') as HTMLIFrameElement;
    const closeBtn = modal.querySelector('.video-modal__close') as HTMLButtonElement;
    const backdrop = modal.querySelector('[data-video-close]') as HTMLElement;
    let lastFocused: HTMLElement | null = null;

    function openVideo(url: string, title: string) {
      lastFocused = document.activeElement as HTMLElement;
      iframe.src = url.includes('autoplay') ? url : `${url}${url.includes('?') ? '&' : '?'}autoplay=1`;
      iframe.title = title;
      modal!.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeVideo() {
      modal!.hidden = true;
      iframe.src = '';
      iframe.title = '';
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element).closest('.video-trigger');
      if (!trigger) return;
      const url = trigger.getAttribute('data-video-url');
      const title = trigger.getAttribute('data-video-title') ?? 'Design video';
      if (url) openVideo(url, title);
    });

    closeBtn.addEventListener('click', closeVideo);
    backdrop.addEventListener('click', closeVideo);

    document.addEventListener('keydown', (e) => {
      if (!modal!.hidden && e.key === 'Escape') closeVideo();
    });
  }

  initVideoModal();
  document.addEventListener('astro:page-load', initVideoModal);
</script>
