---
interface Props {
  image: string;
  imageAlt: string;
}

const { image, imageAlt } = Astro.props;
---

<section class="our-designs-banner" id="our-designs" aria-labelledby="our-designs-heading">
  <div class="our-designs-banner__image">
    <img src={image} alt={imageAlt} loading="lazy" width="1600" height="600" />
    <div class="our-designs-banner__overlay" aria-hidden="true"></div>
  </div>
  <div class="our-designs-banner__content">
    <h2 id="our-designs-heading" class="our-designs-banner__title">OUR DESIGNS</h2>
  </div>
</section>

<style>
  .our-designs-banner {
    position: relative;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .our-designs-banner__image {
    position: absolute;
    inset: 0;
  }

  .our-designs-banner__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
  }

  .our-designs-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  .our-designs-banner__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-xl) var(--space-md);
  }

  .our-designs-banner__title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #ffffff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
</style>
