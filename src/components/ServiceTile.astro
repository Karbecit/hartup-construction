---
interface Props {
  title: string;
  image: string;
  imageAlt: string;
  href: string;
}

const { title, image, imageAlt, href } = Astro.props;
---

<a href={href} class="service-tile">
  <div class="service-tile-image">
    <img src={image} alt={imageAlt} loading="lazy" width="600" height="400" />
  </div>
  <span class="service-tile-label">{title}</span>
</a>

<style>
  .service-tile {
    display: block;
    color: inherit;
    text-align: center;
  }

  .service-tile-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-sm);
    border: 1px solid var(--color-border);
  }

  .service-tile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-tile:hover .service-tile-image img {
    transform: scale(1.06);
  }

  .service-tile-label {
    display: block;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  .service-tile:hover .service-tile-label {
    color: var(--color-accent);
  }
</style>
