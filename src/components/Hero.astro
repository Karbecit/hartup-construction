---
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    <h1 class="hero-tagline">BUILDING QUALITY - CREATING VALUE</h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height) + var(--space-lg)) 0 var(--space-xl);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(15, 20, 25, 0.52) 0%, rgba(26, 35, 50, 0.38) 50%, rgba(15, 20, 25, 0.58) 100%),
      url('https://images.unsplash.com/photo-1770751188011-8ab6c81552bf?w=1920&q=80') center/cover no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(29, 92, 207, 0.03) 0%, transparent 55%),
      linear-gradient(to bottom, rgba(15, 20, 25, 0.15) 0%, rgba(15, 20, 25, 0.28) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    container-type: inline-size;
    width: 100%;
    max-width: 100%;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
    text-align: center;
  }

  @keyframes hero-tagline-fade {
    0% {
      opacity: 0;
      text-shadow:
        0 2px 24px rgba(0, 0, 0, 0.6),
        0 0 60px rgba(0, 0, 0, 0.4);
    }
    25% {
      opacity: 0.1;
    }
    50% {
      opacity: 0.45;
    }
    68% {
      opacity: 1;
      text-shadow:
        0 2px 24px rgba(0, 0, 0, 0.6),
        0 0 60px rgba(0, 0, 0, 0.4);
      animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
    }
    72% {
      opacity: 1;
    }
    85% {
      opacity: 0.72;
      text-shadow:
        0 2px 16px rgba(0, 0, 0, 0.35),
        0 0 30px rgba(0, 0, 0, 0.2);
    }
    100% {
      opacity: 0.55;
      text-shadow:
        0 2px 12px rgba(0, 0, 0, 0.22),
        0 0 18px rgba(0, 0, 0, 0.1);
    }
  }

  @keyframes hero-tagline-scale {
    0% {
      transform: scale(0.3);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    68% {
      transform: scale(1.5);
      animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
    }
    100% {
      transform: scale(1);
    }
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(0.5625rem, 3.05cqi, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: clamp(0.02em, 0.1cqi, 0.06em);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
    text-shadow:
      0 2px 24px rgba(0, 0, 0, 0.6),
      0 0 60px rgba(0, 0, 0, 0.4);
    margin: 0;
    transform-origin: center;
    animation:
      hero-tagline-fade 6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards,
      hero-tagline-scale 6s linear forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tagline {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 85vh;
      padding-bottom: var(--space-2xl);
    }
  }
</style>
