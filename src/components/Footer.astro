---
import { serviceArea, officeContact, projectManagementContact } from '../data/site';

const year = new Date().getFullYear();
const assetVersion = '2';

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/new-builds', label: 'New Builds' },
  { href: '/contact', label: 'Contact Us' },
];

const serviceLinks = [
  { href: '/new-builds', label: 'New Builds' },
  { href: '/upgrades', label: 'Upgrades' },
  { href: '/restorations', label: 'Restorations' },
  { href: '/services', label: 'All Services' },
];

const socialLinks = [
  { href: '#', label: 'Facebook', icon: 'f' },
  { href: '#', label: 'Instagram', icon: 'in' },
  { href: '#', label: 'X (Twitter)', icon: 'X' },
  { href: '#', label: 'YouTube', icon: '▶' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Hartup Construction home">
          <img
            src="/images/logo.png"
            alt="Hartup Construction"
            class="footer-logo-img"
            width="200"
            height="54"
          />
        </a>
        <div class="footer-social">
          {socialLinks.map(({ href, label, icon }) => (
            <a href={href} aria-label={label}>{icon}</a>
          ))}
        </div>
        <div class="footer-accreditations">
          <a href="https://www.hiainsurance.com.au/" target="_blank" rel="noopener noreferrer" aria-label="HIA Insurance Services">
            <img src={`/images/hia-logo.png?v=${assetVersion}`} alt="HIA Insurance Services" class="footer-accreditation-logo footer-accreditation-logo--hia" width="80" height="80" />
          </a>
          <a href="https://mbasa.com.au/" target="_blank" rel="noopener noreferrer" aria-label="Master Builders South Australia">
            <img src={`/images/masterbuilders.jpg?v=${assetVersion}`} alt="Master Builders South Australia" class="footer-accreditation-logo footer-accreditation-logo--mba" width="80" height="80" />
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h3>Quick Links</h3>
        <ul>
          {quickLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links">
        <h3>Services</h3>
        <ul>
          {serviceLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-contact-block">
        <div class="footer-contact-item">
          <span class="contact-icon" aria-hidden="true">📞</span>
          <div>
            <span class="contact-label">{projectManagementContact.department}</span>
            <span class="contact-name">{projectManagementContact.name}</span>
            <a href={`tel:${projectManagementContact.phoneTel}`}>{projectManagementContact.phone}</a>
          </div>
        </div>
        <div class="footer-contact-item">
          <span class="contact-icon" aria-hidden="true">📞</span>
          <div>
            <span class="contact-label">{officeContact.department}</span>
            <a href={`tel:${officeContact.phoneTel}`}>{officeContact.phone}</a>
          </div>
        </div>
        <div class="footer-contact-item">
          <span class="contact-icon" aria-hidden="true">✉</span>
          <div>
            <span class="contact-label">Email</span>
            <a href={`mailto:${officeContact.email}`}>{officeContact.email}</a>
          </div>
        </div>
        <div class="footer-contact-item">
          <span class="contact-icon" aria-hidden="true">📍</span>
          <div>
            <span class="contact-label">Service Area</span>
            <span>{serviceArea}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Hartup Construction. All rights reserved.</p>
      <p class="footer-domain">hartupconstruction.com.au</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #000;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-xl) 0 var(--space-md);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.5fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-md);
    transition: opacity 0.2s;
  }

  .footer-logo:hover {
    opacity: 0.9;
  }

  .footer-logo-img {
    display: block;
    height: 54px;
    width: auto;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: border-color 0.2s, color 0.2s;
  }

  .footer-social a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .footer-accreditations {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: var(--space-md);
  }

  .footer-accreditations a {
    display: block;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .footer-accreditations a:hover {
    opacity: 1;
  }

  .footer-accreditation-logo {
    display: block;
    height: 80px;
    min-height: 80px;
    width: auto;
    max-width: none;
    object-fit: contain;
  }

  .footer-accreditation-logo--mba {
    background: #fff;
    border-radius: 4px;
    padding: 4px 8px;
    box-sizing: content-box;
  }

  .footer-links h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-contact-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .contact-icon {
    font-size: 1rem;
    opacity: 0.7;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .contact-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.125rem;
  }

  .contact-name {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text);
    margin-bottom: 0.125rem;
  }

  .footer-contact-item a,
  .footer-contact-item span:last-child {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .footer-contact-item a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer-domain {
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
