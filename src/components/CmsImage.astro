---
interface CmsImageData {
  file: string;
  alt?: string;
  crop_x?: number;
  crop_y?: number;
  crop_zoom?: number;
  crop_x_mobile?: number;
  crop_y_mobile?: number;
  crop_zoom_mobile?: number;
  aspect_ratio?: number;
  slides?: CmsImageData[];
  transition?: string;
  transition_ms?: number;
  hold_seconds?: number;
}

interface Props {
  image: CmsImageData;
  class?: string;
  aspect?: number;
  fullWidth?: boolean;
}

const { image, class: className, aspect, fullWidth = false } = Astro.props;

function imageSrc(file: string): string {
  if (!file) return '';
  const parts = file.replace(/^\/?images\//, '').split('/').map(encodeURIComponent);
  return `/images/${parts.join('/')}`;
}

function imageFrames(value: CmsImageData): CmsImageData[] {
  const frames: CmsImageData[] = [];
  if (value.file) frames.push(value);
  for (const slide of value.slides ?? []) {
    if (slide?.file) frames.push(slide);
  }
  return frames;
}

const frames = imageFrames(image);
const src = frames[0] ? imageSrc(frames[0].file) : '';
const ratio = aspect ?? image.aspect_ratio ?? (fullWidth ? 16 / 9 : 4 / 3);
const isSlideshow = frames.length > 1;
const transition = image.transition || 'fade';
const transitionMs = image.transition_ms ?? 800;
const holdSeconds = image.hold_seconds ?? 5;
---

{src && !isSlideshow && (
  <div
    class:list={['cms-image', 'image-crop-view', className, { 'cms-image--full': fullWidth }]}
    style={`--cms-aspect: ${ratio}`}
    data-crop-x={image.crop_x ?? 0}
    data-crop-y={image.crop_y ?? 0}
    data-crop-zoom={image.crop_zoom ?? 1}
    data-crop-x-mobile={image.crop_x_mobile ?? image.crop_x ?? 0}
    data-crop-y-mobile={image.crop_y_mobile ?? image.crop_y ?? 0}
    data-crop-zoom-mobile={image.crop_zoom_mobile ?? image.crop_zoom ?? 1}
    data-aspect={ratio}
  >
    <img src={src} alt={image.alt ?? ''} loading="lazy" width="1200" height="800" />
  </div>
)}

{src && isSlideshow && (
  <div
    class:list={['cms-image', 'cms-slideshow', className, { 'cms-image--full': fullWidth }]}
    style={`--cms-aspect: ${ratio}; --slide-duration: ${transitionMs}ms`}
    data-slideshow
    data-transition={transition}
    data-transition-ms={transitionMs}
    data-hold-seconds={holdSeconds}
  >
    {frames.map((frame, index) => (
      <div
        class:list={['cms-slideshow__slide', 'image-crop-view', { 'is-active': index === 0 }]}
        data-crop-x={frame.crop_x ?? 0}
        data-crop-y={frame.crop_y ?? 0}
        data-crop-zoom={frame.crop_zoom ?? 1}
        data-crop-x-mobile={frame.crop_x_mobile ?? frame.crop_x ?? 0}
        data-crop-y-mobile={frame.crop_y_mobile ?? frame.crop_y ?? 0}
        data-crop-zoom-mobile={frame.crop_zoom_mobile ?? frame.crop_zoom ?? 1}
        data-aspect={ratio}
      >
        <img
          src={imageSrc(frame.file)}
          alt={frame.alt ?? image.alt ?? ''}
          loading={index === 0 ? 'eager' : 'lazy'}
          width="1200"
          height="800"
        />
      </div>
    ))}
  </div>
)}

<style>
  .cms-image {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: var(--cms-aspect, 4 / 3);
  }

  .cms-image--full {
    border-radius: 0;
    width: 100%;
  }

  .cms-image img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    width: auto;
    height: auto;
    object-fit: unset;
  }

  .cms-slideshow__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
    aspect-ratio: unset;
    overflow: hidden;
  }
</style>

<script src="/image-crop-view.js" defer></script>
<script src="/image-slideshow.js?v=2" defer></script>
