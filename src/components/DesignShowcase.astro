---
import type { Design } from '../data/designs';
import { formatPrice, formatDimensions } from '../data/designs';

interface Props {
  design: Design;
  index: number;
}

const { design, index } = Astro.props;

const bgClass = index % 2 === 0 ? 'section--bg-default' : 'section--bg-elevated';
const enquiryHref = `/contact?design=${encodeURIComponent(design.name)}`;
const priceFormatted = formatPrice(design.priceFrom);
const dimensionsFormatted = formatDimensions(design.width, design.length, design.totalArea);
const sectionId = `design-${design.slug}`;
---

<section
  class:list={['section', 'design-showcase', bgClass]}
  id={sectionId}
  aria-labelledby={`${sectionId}-title`}
>
  <div class="container">
    <div class="design-showcase__grid">
      <div class="design-showcase__info">
        <div class="design-showcase__panel">
          <h3 id={`${sectionId}-title`} class="design-showcase__name">{design.name}</h3>
          <div class="design-showcase__description">
            {design.description.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="design-showcase__specs">
            <p class="design-showcase__price">
              Priced from: <strong>{priceFormatted}</strong>
            </p>
            <table class="design-showcase__table" aria-label={`${design.name} dimensions`}>
              <caption class="sr-only">{design.name} specifications</caption>
              <tbody>
                <tr>
                  <th scope="row">Overall dimensions</th>
                  <td>{dimensionsFormatted}</td>
                </tr>
              </tbody>
            </table>
            <ul class="design-showcase__icons" aria-label="Room counts">
              <li class="design-showcase__spec">
                <span class="design-showcase__icon" aria-hidden="true">
                  <img src="/images/icon_bed_blue_small.png" alt="" width="22" height="22" />
                </span>
                <span class="design-showcase__spec-text">
                  <span class="design-showcase__spec-label">Bedrooms</span>
                  <span class="design-showcase__spec-value">{design.bedrooms}</span>
                </span>
              </li>
              <li class="design-showcase__spec">
                <span class="design-showcase__icon" aria-hidden="true">
                  <img src="/images/icon_shower_blue_small.png" alt="" width="22" height="22" />
                </span>
                <span class="design-showcase__spec-text">
                  <span class="design-showcase__spec-label">Bathrooms</span>
                  <span class="design-showcase__spec-value">{design.bathrooms}</span>
                </span>
              </li>
            </ul>
          </div>

          <div class="design-showcase__actions btn-group">
            <a
              href={design.floorplanPdfUrl}
              class="btn btn-outline"
              download={design.floorplanPdfUrl !== '#' ? `${design.slug}-floorplan.pdf` : undefined}
              target={design.floorplanPdfUrl === '#' ? undefined : '_blank'}
              rel={design.floorplanPdfUrl === '#' ? undefined : 'noopener noreferrer'}
            >
              Download Floorplan
            </a>
            {design.videoUrl && (
              <button
                type="button"
                class="btn btn-outline video-trigger"
                data-video-url={design.videoUrl}
                data-video-title={`${design.name} walkthrough video`}
              >
                View Video
              </button>
            )}
            <a href={enquiryHref} class="btn btn-primary">Enquire About This Design</a>
          </div>
        </div>
      </div>

      <div class="design-showcase__gallery">
        <figure class="design-showcase__figure design-showcase__figure--hero design-showcase__figure--floorplan">
          <button
            type="button"
            class="design-showcase__image-btn lightbox-trigger"
            data-lightbox-src={design.floorplanImage}
            data-lightbox-alt={design.floorplanImageAlt}
            aria-label={`View larger image: ${design.floorplanImageAlt}`}
          >
            <img
              src={design.floorplanImage}
              alt={design.floorplanImageAlt}
              loading="lazy"
              width="900"
              height="600"
            />
          </button>
          <figcaption>{design.floorplanImageCaption ?? 'Floor Plan'}</figcaption>
        </figure>

        <div class="design-showcase__floorplans">
          <figure class="design-showcase__figure design-showcase__figure--zoom">
            <button
              type="button"
              class="design-showcase__image-btn lightbox-trigger"
              data-lightbox-src={design.exteriorImage}
              data-lightbox-alt={design.exteriorImageAlt}
              aria-label={`View larger image: ${design.exteriorImageAlt}`}
            >
              <img
                src={design.exteriorImage}
                alt={design.exteriorImageAlt}
                loading="lazy"
                width="450"
                height="350"
              />
            </button>
            <figcaption>{design.exteriorImageCaption ?? 'Exterior view'}</figcaption>
          </figure>
          <figure class="design-showcase__figure design-showcase__figure--zoom">
            <button
              type="button"
              class="design-showcase__image-btn lightbox-trigger"
              data-lightbox-src={design.floorplan3dImage}
              data-lightbox-alt={design.floorplan3dImageAlt}
              aria-label={`View larger image: ${design.floorplan3dImageAlt}`}
            >
              <img
                src={design.floorplan3dImage}
                alt={design.floorplan3dImageAlt}
                loading="lazy"
                width="450"
                height="350"
              />
            </button>
            <figcaption>{design.thirdImageCaption ?? 'Exterior view'}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .design-showcase__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .design-showcase__panel {
    background: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    color: #1a2332;
  }

  .design-showcase__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: #0f1419;
    margin-bottom: var(--space-sm);
  }

  .design-showcase__description {
    color: #475569;
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .design-showcase__description p {
    margin-bottom: var(--space-sm);
  }

  .design-showcase__description p:last-child {
    margin-bottom: 0;
  }

  .design-showcase__specs {
    background: #ffffff;
    border: 1px solid rgba(15, 20, 25, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .design-showcase__price {
    font-size: 1.0625rem;
    color: #1a2332;
    margin-bottom: var(--space-sm);
  }

  .design-showcase__price strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .design-showcase__table {
    width: 100%;
    margin-bottom: var(--space-sm);
    border-collapse: collapse;
  }

  .design-showcase__table th,
  .design-showcase__table td {
    padding: 0.375rem 0;
    text-align: left;
    font-size: 0.9375rem;
    color: #475569;
  }

  .design-showcase__table th {
    font-weight: 600;
    color: #1a2332;
    padding-right: var(--space-sm);
    white-space: nowrap;
  }

  .design-showcase__icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .design-showcase__spec {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 7rem;
  }

  .design-showcase__spec-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .design-showcase__spec-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
  }

  .design-showcase__spec-value {
    font-size: 1rem;
    font-weight: 700;
    color: #1a2332;
    line-height: 1;
  }

  .design-showcase__icon {
    display: flex;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .design-showcase__icon img {
    display: block;
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .design-showcase__actions {
    margin-top: var(--space-md);
  }

  .design-showcase__panel .btn-outline {
    color: #1a2332;
    border-color: rgba(15, 20, 25, 0.35);
    background: #ffffff;
  }

  .design-showcase__panel .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(29, 92, 207, 0.04);
  }

  .design-showcase__figure {
    margin: 0;
  }

  .design-showcase__figure--hero {
    margin-bottom: var(--space-md);
  }

  .design-showcase__image-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: opacity 0.2s, transform 0.2s;
  }

  .design-showcase__image-btn:hover {
    opacity: 0.92;
    transform: scale(1.01);
  }

  .design-showcase__image-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .design-showcase__image-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .design-showcase__figure--hero .design-showcase__image-btn {
    aspect-ratio: 4 / 3;
  }

  .design-showcase__floorplans {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .design-showcase__floorplans .design-showcase__image-btn {
    aspect-ratio: 4 / 3;
  }

  .design-showcase__figure--zoom .design-showcase__image-btn img {
    object-fit: cover;
    transform: scale(1.2);
  }

  .design-showcase__figure--floorplan .design-showcase__image-btn {
    background: #f8fafc;
  }

  .design-showcase__figure--floorplan img {
    object-fit: contain;
  }

  .design-showcase__figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .design-showcase__grid {
      grid-template-columns: 1fr;
    }

    .design-showcase__info {
      order: 1;
    }

    .design-showcase__gallery {
      order: 2;
    }

    .design-showcase__actions {
      flex-direction: column;
    }

    .design-showcase__actions .btn {
      width: 100%;
    }
  }
</style>
