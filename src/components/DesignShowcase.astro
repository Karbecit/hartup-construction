---
import CmsImage from './CmsImage.astro';
import { isCmsPageVisible, type CmsImageField } from '../lib/cms';

export interface CmsDesignItem {
  id?: string;
  name?: string;
  description?: string[];
  bullets?: string[];
  price_from?: string;
  width?: string;
  length?: string;
  area?: string;
  bedrooms?: string;
  bathrooms?: string;
  floorplan_pdf?: string;
  video_url?: string;
  image_position?: 'left' | 'right';
  hero_image?: CmsImageField;
  hero_caption?: string;
  image_2?: CmsImageField;
  image_2_caption?: string;
  image_3?: CmsImageField;
  image_3_caption?: string;
}

interface Props {
  design: CmsDesignItem;
  index: number;
}

const { design, index } = Astro.props;

const bgClass = index % 2 === 0 ? 'section--bg-default' : 'section--bg-elevated';
const name = design.name || 'Design';
const enquiryHref = `/contact?design=${encodeURIComponent(name)}`;
const showEnquire = isCmsPageVisible('contact');
const slug = (design.id || name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'design';
const sectionId = `design-${slug}`;
const imagesLeft = design.image_position === 'left';
const pdfUrl = (design.floorplan_pdf || '').trim();
const videoUrl = toEmbedUrl((design.video_url || '').trim());
const width = (design.width || '').trim();
const length = (design.length || '').trim();
const area = (design.area || '').trim();
const dimensionsFormatted = [width, length].filter(Boolean).length
  ? `${width}${width && length ? ' × ' : ''}${length}${width || length ? ' m' : ''}${area ? ` | ${area} m²` : ''}`
  : area
    ? `${area} m²`
    : '';

function toEmbedUrl(url: string): string {
  if (!url) return '';
  const watch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/i);
  if (watch) return `https://www.youtube.com/embed/${watch[1]}`;
  return url;
}

function lightboxSrc(image?: CmsImageField): string {
  const file = image?.file || '';
  if (!file) return '';
  const parts = file.replace(/^\/?images\//, '').split('/').map(encodeURIComponent);
  return `/images/${parts.join('/')}`;
}

const heroSrc = lightboxSrc(design.hero_image);
const image2Src = lightboxSrc(design.image_2);
const image3Src = lightboxSrc(design.image_3);
---

<section
  class:list={['section', 'design-showcase', bgClass]}
  id={sectionId}
  aria-labelledby={`${sectionId}-title`}
>
  <div class="container">
    <div class:list={['design-showcase__grid', { 'design-showcase__grid--images-left': imagesLeft }]}>
      <div class="design-showcase__info">
        <div class="design-showcase__panel">
          <h3 id={`${sectionId}-title`} class="design-showcase__name">{name}</h3>
          {((design.description ?? []).length > 0 || (design.bullets ?? []).length > 0) && (
            <div class="design-showcase__description">
              {(design.description ?? []).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {(design.bullets ?? []).length > 0 && (
                <ul class="design-showcase__bullets">
                  {(design.bullets ?? []).map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          )}

          <div class="design-showcase__specs">
            {design.price_from && (
              <p class="design-showcase__price">
                Priced from: <strong>{design.price_from}</strong>
              </p>
            )}
            {dimensionsFormatted && (
              <table class="design-showcase__table" aria-label={`${name} dimensions`}>
                <caption class="sr-only">{name} specifications</caption>
                <tbody>
                  <tr>
                    <th scope="row">Overall dimensions</th>
                    <td>{dimensionsFormatted}</td>
                  </tr>
                </tbody>
              </table>
            )}
            <ul class="design-showcase__icons" aria-label="Room counts">
              {design.bedrooms && (
                <li class="design-showcase__spec">
                  <span class="design-showcase__icon" aria-hidden="true">
                    <img src="/images/icon_bed_blue_small.png" alt="" width="22" height="22" />
                  </span>
                  <span class="design-showcase__spec-text">
                    <span class="design-showcase__spec-label">Bedrooms</span>
                    <span class="design-showcase__spec-value">{design.bedrooms}</span>
                  </span>
                </li>
              )}
              {design.bathrooms && (
                <li class="design-showcase__spec">
                  <span class="design-showcase__icon" aria-hidden="true">
                    <img src="/images/icon_shower_blue_small.png" alt="" width="22" height="22" />
                  </span>
                  <span class="design-showcase__spec-text">
                    <span class="design-showcase__spec-label">Bathrooms</span>
                    <span class="design-showcase__spec-value">{design.bathrooms}</span>
                  </span>
                </li>
              )}
            </ul>
          </div>

          <div class="design-showcase__actions btn-group">
            {pdfUrl && (
              <a
                href={pdfUrl}
                class="btn btn-outline"
                download={`${slug}-floorplan.pdf`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Download Floorplan
              </a>
            )}
            {videoUrl && (
              <button
                type="button"
                class="btn btn-outline video-trigger"
                data-video-url={videoUrl}
                data-video-title={`${name} walkthrough video`}
              >
                View Video
              </button>
            )}
            {showEnquire && <a href={enquiryHref} class="btn btn-primary">Enquire About This Design</a>}
          </div>
        </div>
      </div>

      <div class="design-showcase__gallery">
        {heroSrc && design.hero_image && (
          <figure class="design-showcase__figure design-showcase__figure--hero design-showcase__figure--floorplan">
            <button
              type="button"
              class="design-showcase__image-btn lightbox-trigger"
              data-lightbox-src={heroSrc}
              data-lightbox-alt={design.hero_image.alt || design.hero_caption || name}
              aria-label={`View larger image: ${design.hero_image.alt || design.hero_caption || name}`}
            >
              <CmsImage image={design.hero_image} aspect={design.hero_image.aspect_ratio ?? 4 / 3} class="design-showcase__cms-image" />
            </button>
            <figcaption>{design.hero_caption || 'Floor Plan'}</figcaption>
          </figure>
        )}

        {(image2Src || image3Src) && (
          <div class="design-showcase__floorplans">
            {image2Src && design.image_2 && (
              <figure class="design-showcase__figure design-showcase__figure--zoom">
                <button
                  type="button"
                  class="design-showcase__image-btn lightbox-trigger"
                  data-lightbox-src={image2Src}
                  data-lightbox-alt={design.image_2.alt || design.image_2_caption || name}
                  aria-label={`View larger image: ${design.image_2.alt || design.image_2_caption || name}`}
                >
                  <CmsImage image={design.image_2} aspect={design.image_2.aspect_ratio ?? 4 / 3} class="design-showcase__cms-image" />
                </button>
                <figcaption>{design.image_2_caption || 'Exterior view'}</figcaption>
              </figure>
            )}
            {image3Src && design.image_3 && (
              <figure class="design-showcase__figure design-showcase__figure--zoom">
                <button
                  type="button"
                  class="design-showcase__image-btn lightbox-trigger"
                  data-lightbox-src={image3Src}
                  data-lightbox-alt={design.image_3.alt || design.image_3_caption || name}
                  aria-label={`View larger image: ${design.image_3.alt || design.image_3_caption || name}`}
                >
                  <CmsImage image={design.image_3} aspect={design.image_3.aspect_ratio ?? 4 / 3} class="design-showcase__cms-image" />
                </button>
                <figcaption>{design.image_3_caption || 'Exterior view'}</figcaption>
              </figure>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .design-showcase__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .design-showcase__grid--images-left {
    grid-template-columns: 1.1fr 1fr;
  }

  .design-showcase__grid--images-left .design-showcase__gallery {
    order: 1;
  }

  .design-showcase__grid--images-left .design-showcase__info {
    order: 2;
  }

  .design-showcase__panel {
    background: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    color: #1a2332;
  }

  .design-showcase__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: #0f1419;
    margin-bottom: var(--space-sm);
  }

  .design-showcase__description {
    color: #475569;
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .design-showcase__description p {
    margin-bottom: var(--space-sm);
  }

  .design-showcase__description p:last-child {
    margin-bottom: 0;
  }

  .design-showcase__bullets {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
  }

  .design-showcase__bullets li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .design-showcase__bullets li:last-child {
    margin-bottom: 0;
  }

  .design-showcase__bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .design-showcase__specs {
    background: #ffffff;
    border: 1px solid rgba(15, 20, 25, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .design-showcase__price {
    font-size: 1.0625rem;
    color: #1a2332;
    margin-bottom: var(--space-sm);
  }

  .design-showcase__price strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .design-showcase__table {
    width: 100%;
    margin-bottom: var(--space-sm);
    border-collapse: collapse;
  }

  .design-showcase__table th,
  .design-showcase__table td {
    padding: 0.375rem 0;
    text-align: left;
    font-size: 0.9375rem;
    color: #475569;
  }

  .design-showcase__table th {
    font-weight: 600;
    color: #1a2332;
    padding-right: var(--space-sm);
    white-space: nowrap;
  }

  .design-showcase__icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .design-showcase__spec {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 7rem;
  }

  .design-showcase__spec-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .design-showcase__spec-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
  }

  .design-showcase__spec-value {
    font-size: 1rem;
    font-weight: 700;
    color: #1a2332;
    line-height: 1;
  }

  .design-showcase__icon {
    display: flex;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .design-showcase__icon img {
    display: block;
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .design-showcase__actions {
    margin-top: var(--space-md);
  }

  .design-showcase__panel .btn-outline {
    color: #1a2332;
    border-color: rgba(15, 20, 25, 0.35);
    background: #ffffff;
  }

  .design-showcase__panel .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(29, 92, 207, 0.04);
  }

  .design-showcase__figure {
    margin: 0;
  }

  .design-showcase__figure--hero {
    margin-bottom: var(--space-md);
  }

  .design-showcase__image-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: opacity 0.2s, transform 0.2s;
  }

  .design-showcase__image-btn:hover {
    opacity: 0.92;
    transform: scale(1.01);
  }

  .design-showcase__image-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .design-showcase__image-btn :global(.cms-image),
  .design-showcase__image-btn :global(.design-showcase__cms-image) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    aspect-ratio: unset;
  }

  .design-showcase__figure--hero .design-showcase__image-btn {
    aspect-ratio: 4 / 3;
  }

  .design-showcase__floorplans {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .design-showcase__floorplans .design-showcase__image-btn {
    aspect-ratio: 4 / 3;
  }

  .design-showcase__figure--zoom .design-showcase__image-btn :global(.cms-image img) {
    transform: scale(1.2);
  }

  .design-showcase__figure--floorplan .design-showcase__image-btn {
    background: #f8fafc;
  }

  .design-showcase__figure--floorplan :global(.cms-image img) {
    object-fit: contain;
  }

  .design-showcase__figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .design-showcase__grid,
    .design-showcase__grid--images-left {
      grid-template-columns: 1fr;
    }

    .design-showcase__info,
    .design-showcase__grid--images-left .design-showcase__info {
      order: 1;
    }

    .design-showcase__gallery,
    .design-showcase__grid--images-left .design-showcase__gallery {
      order: 2;
    }

    .design-showcase__actions {
      flex-direction: column;
    }

    .design-showcase__actions .btn {
      width: 100%;
    }
  }
</style>
