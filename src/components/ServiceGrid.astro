---
interface GridItem {
  label: string;
  href: string;
  image: string;
  alt: string;
}

interface Props {
  items: readonly GridItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['bedroom-grid', className]}>
  {items.map(({ label, href, image, alt }) => (
    <a href={href} class="bedroom-card">
      <div class="bedroom-image zoom-image">
        <img src={image} alt={alt} loading="lazy" width="400" height="300" />
      </div>
      <span class="bedroom-label">{label}</span>
    </a>
  ))}
</div>

<style>
  .bedroom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .bedroom-card {
    display: block;
    text-align: center;
    transition: opacity 0.2s;
  }

  .bedroom-card:hover {
    opacity: 0.95;
  }

  .bedroom-image {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .bedroom-label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .zoom-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
    transition: transform 0.5s ease;
  }

  .zoom-image:hover img {
    transform: scale(1);
  }

  @media (max-width: 640px) {
    .bedroom-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
