---
import Layout from '../layouts/Layout.astro';
import { serviceAreaLong } from '../data/site';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';

const projects = [
  {
    title: 'Modern Family Home — Melbourne',
    category: 'Residential',
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&q=80',
    imageAlt: 'Modern two-storey family home with large windows and landscaped garden',
  },
  {
    title: 'Coastal Retreat — Gold Coast',
    category: 'Residential',
    image: 'https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=600&q=80',
    imageAlt: 'Luxury coastal home with pool and ocean views',
  },
  {
    title: 'Heritage Terrace Renovation — Sydney',
    category: 'Renovation',
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=600&q=80',
    imageAlt: 'Renovated heritage terrace home with restored facade',
  },
  {
    title: 'Corporate Office Fit-Out — Brisbane',
    category: 'Commercial',
    image: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&q=80',
    imageAlt: 'Modern open-plan corporate office with glass partitions',
  },
  {
    title: 'Retail Showroom — Adelaide',
    category: 'Commercial',
    image: 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600&q=80',
    imageAlt: 'Bright retail showroom with display fixtures and polished floors',
  },
  {
    title: 'Kitchen & Living Extension — Perth',
    category: 'Renovation',
    image: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=600&q=80',
    imageAlt: 'Open-plan kitchen and living area with modern finishes',
  },
  {
    title: 'Multi-Unit Development — Canberra',
    category: 'Residential',
    image: 'https://images.unsplash.com/photo-1545324418-c1dbe4fc1b8b?w=600&q=80',
    imageAlt: 'Modern apartment building with balconies and clean architecture',
  },
  {
    title: 'Medical Clinic Build — Hobart',
    category: 'Commercial',
    image: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=600&q=80',
    imageAlt: 'Clean, modern medical clinic reception and waiting area',
  },
  {
    title: 'Outdoor Entertaining Area — Darwin',
    category: 'Renovation',
    image: 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=600&q=80',
    imageAlt: 'Outdoor deck and entertaining area with pergola and seating',
  },
];

const categories = ['All', 'Residential', 'Commercial', 'Renovation'];
---

<Layout
  title="Projects"
  description={`Browse Hartup Construction's portfolio of residential, commercial, and renovation projects in ${serviceAreaLong}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Our Work</span>
      <h1>Project Gallery</h1>
      <p class="lead">
        Explore a selection of completed projects showcasing our craftsmanship, attention to detail, and diverse capabilities.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-bar" role="group" aria-label="Filter projects by category">
        {categories.map((cat) => (
          <button
            class="filter-btn"
            data-filter={cat === 'All' ? 'all' : cat.toLowerCase()}
            aria-pressed={cat === 'All' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="projects-grid grid-3" id="projects-grid">
        {projects.map((project) => (
          <div class="project-item" data-category={project.category.toLowerCase()}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Have a Project in Mind?"
    description="We'd love to add your build to our portfolio. Get in touch to discuss your ideas."
  />
</Layout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-lg);
    justify-content: center;
  }

  .filter-btn {
    padding: 0.5rem 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
  }

  .project-item.hidden {
    display: none;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      projectItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  document.querySelector('.filter-btn')?.classList.add('active');
</script>
