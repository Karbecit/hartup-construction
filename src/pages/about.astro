---
import Layout from '../layouts/Layout.astro';
import { getPage, isCmsPageVisible, serviceAreaLong } from '../data/site';
import CmsSections from '../components/CmsSections.astro';
import CTA from '../components/CTA.astro';

const aboutPage = getPage('about');
if (!isCmsPageVisible('about')) {
  return new Response('Not found', { status: 404, statusText: 'Not Found' });
}
const pageHero = aboutPage?.page_hero;
const sections = aboutPage?.sections ?? [];
---

<Layout
  title="About Us"
  description={`Learn about Hartup Construction — our story, values, and commitment to quality building in ${serviceAreaLong}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{pageHero?.eyebrow ?? 'Our Story'}</span>
      <h1>{pageHero?.heading ?? 'About Hartup Construction'}</h1>
      <p class="lead">{pageHero?.lead ?? 'A trusted Adelaide building company dedicated to quality craftsmanship, honest communication, and projects that stand the test of time.'}</p>
    </div>
  </section>

  <CmsSections sections={sections} />

  <CTA
    title="Let's Build Something Together"
    description="Whether you're planning a new build, renovation, or commercial fit-out, we'd love to hear about your project."
  />
</Layout>

<style>
  .page-hero .container {
    max-width: 820px;
  }
</style>
