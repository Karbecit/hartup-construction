---
import Layout from '../layouts/Layout.astro';
import ImageCrossfade from '../components/ImageCrossfade.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CTA from '../components/CTA.astro';
import { upgradeImages } from '../data/upgradeImages';
import { serviceAreaLong } from '../data/site';
import { bedroomImages } from '../data/bedroomImages';

const serviceGrid = [
  {
    label: 'Kitchen Restorations',
    href: '/contact?service=kitchen-restoration',
    image: upgradeImages.kitchenRestore,
    alt: 'Before and after kitchen restoration preserving home character',
  },
  {
    label: 'Heritage Homes',
    href: '/contact?service=heritage-restoration',
    image: bedroomImages['three-bedroom'].exterior,
    alt: 'Character home exterior with timber cladding and traditional detailing',
  },
  {
    label: 'Bathroom Restorations',
    href: '/contact?service=bathroom-restoration',
    image: upgradeImages.bathroom,
    alt: 'Restored bathroom with contemporary fixtures and quality finishes',
  },
];

const featuredGrid = [
  {
    label: 'Kitchen Revival',
    href: '/contact?service=kitchen-restoration',
    image: upgradeImages.kitchenRestore,
    alt: 'Kitchen restoration before and after',
  },
  {
    label: 'Character Exteriors',
    href: '/contact?service=heritage-restoration',
    image: bedroomImages['one-bedroom'].exteriorAlt,
    alt: 'Restored timber-clad home exterior',
  },
  {
    label: 'Modern Bathroom',
    href: '/contact?service=bathroom-restoration',
    image: upgradeImages.bathroomAlt2,
    alt: 'Restored bathroom with premium fixtures',
  },
];

const approachSlideshow = [
  { src: upgradeImages.kitchenRestore, alt: 'Sympathetic kitchen restoration before and after' },
  { src: bedroomImages['two-bedroom'].exterior, alt: 'Character home with restored exterior finishes' },
  { src: bedroomImages['three-bedroom'].exteriorAlt, alt: 'Heritage-style home with updated detailing' },
];

const benefitsSlideshow = [
  { src: bedroomImages['one-bedroom'].exterior, alt: 'Restored home exterior with timber character' },
  { src: upgradeImages.bathroomAlt, alt: 'Updated bathroom within a restored property' },
  { src: upgradeImages.kitchen, alt: 'Modern kitchen integrated into a character home' },
];

const craftSlideshow = [
  { src: upgradeImages.bathroom, alt: 'Quality bathroom restoration finishes' },
  { src: upgradeImages.kitchenRestore, alt: 'Detailed kitchen restoration workmanship' },
  { src: bedroomImages['two-bedroom'].exteriorAlt, alt: 'Exterior restoration with contemporary materials' },
];

const approachPoints = [
  'Sympathetic restoration that respects original architectural features',
  'Structural repairs, repointing, and weatherproofing where required',
  'Kitchen and bathroom updates that complement period character',
  'Timber, brick, and heritage material repair and replacement',
  'Compliance upgrades to meet current building standards',
  'Detailed documentation and staged works for complex projects',
];

const benefits = [
  'Preserve heritage value and street appeal',
  'Improve comfort, safety, and energy performance',
  'Resolve structural issues before they escalate',
  'Blend traditional character with modern functionality',
  'Increase long-term property value and marketability',
  'Experienced team familiar with restoration challenges',
  'Coordinated trades under a single project manager',
  'Quality workmanship backed by warranty',
];

const craftPoints = [
  'Careful strip-out and protection of retained features',
  'Matching profiles, mouldings, and period-appropriate materials',
  'Skilled joinery, tiling, and finishing trades',
  'Final detailing that honours the original build',
];
---

<Layout
  title="Restorations"
  description={`Heritage and property restorations by Hartup Construction — preserving character while meeting modern standards in ${serviceAreaLong}.`}
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-title-serif">Restorations</h1>
      <p class="lead">
        Breathe new life into heritage and character properties with careful restoration work that respects original features while improving comfort and compliance.
      </p>
    </div>
  </section>

  <section class="section section--bg-default service-row-section">
    <div class="container">
      <ServiceGrid items={serviceGrid} />
    </div>
  </section>

  <section class="section section--bg-elevated">
    <div class="container">
      <div class="split-grid split-grid--text-left">
        <div class="split-grid__content">
          <span class="eyebrow">Our Approach</span>
          <h2>Restoration Services &amp; Scope</h2>
          <p class="lead">
            Hartup Construction approaches every restoration with respect for the original fabric of the building — combining traditional craftsmanship with modern building standards.
          </p>
          <ul class="split-list">
            {approachPoints.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
        <div class="split-grid__media">
          <ImageCrossfade id="restoration-approach" images={approachSlideshow} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bg-default">
    <div class="container">
      <div class="split-grid">
        <div class="split-grid__media">
          <ImageCrossfade id="restoration-benefits" images={benefitsSlideshow} />
        </div>
        <div class="split-grid__content">
          <span class="eyebrow">Benefits</span>
          <h2>Why Restore with Hartup</h2>
          <p class="lead">
            Restoration is an investment in both history and liveability — delivering a home that feels authentic while working for modern life.
          </p>
          <ul class="split-list">
            {benefits.map((benefit) => (
              <li>{benefit}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bg-elevated">
    <div class="container">
      <div class="split-grid split-grid--text-left">
        <div class="split-grid__content">
          <span class="eyebrow">Craftsmanship</span>
          <h2>Quality Restoration Work</h2>
          <p class="lead">
            From careful preparation through to final finishes, our restoration work prioritises durability, authenticity, and attention to detail.
          </p>
          <ul class="split-list">
            {craftPoints.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p>
            Whether you own a heritage-listed property or a character home needing renewal, we assess the building, recommend a practical scope, and deliver restoration work you can trust.
          </p>
        </div>
        <div class="split-grid__media">
          <ImageCrossfade id="restoration-craft" images={craftSlideshow} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bg-default service-row-section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Expertise</span>
        <h2>Restoration Specialisations</h2>
        <p>From kitchen revivals to full character home renewals — explore the restoration work we deliver throughout the Adelaide metro and surrounding areas.</p>
      </div>
      <ServiceGrid items={featuredGrid} />
    </div>
  </section>

  <CTA
    sectionClass="section--bg-elevated"
    title="Have a Restoration Project?"
    description="Our team can assess your property and recommend the best approach to preserve its character."
    buttonLabel="Contact Us"
  />
</Layout>

<style>
  .service-row-section {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .split-grid__content h2 {
    margin-bottom: var(--space-sm);
  }

  .split-grid__content p {
    margin-bottom: var(--space-sm);
  }

  .split-list {
    margin: var(--space-md) 0 var(--space-lg);
  }

  .split-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .split-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .split-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
