---
import Layout from '../layouts/Layout.astro';
import { getPage, serviceAreaLong } from '../data/site';
import Hero from '../components/Hero.astro';
import CmsSections from '../components/CmsSections.astro';
import CTA from '../components/CTA.astro';

const homePage = getPage('home');
const sections = homePage?.sections ?? [];
---

<Layout
  title="Hartup Construction"
  description={`Hartup Construction — quality residential and commercial building services in ${serviceAreaLong}. Licensed builders delivering projects on time, on budget, and to the highest standards.`}
>
  <Hero />
  <CmsSections sections={sections} />
  <CTA sectionClass="section--bg-elevated" />
</Layout>
