                {
                    "id": "home_about",
                    "type": "image_text",
                    "enabled": true,
                    "background": "elevated",
                    "heading_size": "lg",
                    "heading_weight": "semibold",
                    "text_size": "normal",
                    "eyebrow_size": "normal",
                    "eyebrow": "Trusted South Australian building and property services company",
                    "heading": "About Hartup",
                    "paragraphs": [
                        "Hartup Construction is a trusted South Australian building and property services company dedicated to delivering high-quality construction, renovation, and maintenance solutions for residential and investment properties.",
                        "With a strong commitment to workmanship, reliability, and customer satisfaction. Hartup Construction provides a complete range of building services, from new home construction and tiny home developments through to comprehensive property refurbishments and ongoing maintenance programs.",
                        "Our experienced team works closely with homeowners, investors, property managers, commercial and government clients to create functional, modern, and value-driven spaces.",
                        "Whether constructing a custom family home, delivering an affordable tiny home solution, or undertaking extensive renovations, we focus on quality workmanship, attention to detail, and efficient project delivery."
                    ],
                    "bullets": [
                        "Transparent quoting and project timelines",
                        "Full compliance with Australian building codes",
                        "Dedicated project manager on every build",
                        "Comprehensive warranty on all workmanship"
                    ],
                    "image_position": "right",
                    "image_scale": 1,
                    "image": {
                        "file": "Aura_68_Front_6bb4f4.png",
                        "alt": "Modern tiny home exterior",
                        "crop_x": 0,
                        "crop_y": 0,
                        "crop_zoom": 1,
                        "crop_x_mobile": 0,
                        "crop_y_mobile": 0,
                        "crop_zoom_mobile": 1,
                        "aspect_ratio": 1.3333,
                        "cropped_area_pixels": ""
                    }
                },
                {
                    "id": "home_specialises",
                    "type": "image_text",
                    "enabled": true,
                    "background": "default",
                    "heading_size": "lg",
                    "heading_weight": "semibold",
                    "text_size": "normal",
                    "eyebrow_size": "normal",
                    "eyebrow": "What We Do",
                    "heading": "Our Services",
                    "paragraphs": [
                        "From ground-up builds to detailed interior upgrades — tailored construction services for homes and commercial spaces throughout the Adelaide metro and surrounding areas."
                    ],
                    "bullets": [
                        "New Home Builds – Custom-designed homes built to suit individual lifestyles, budgets, and future needs.",
                        "Secondary Dwellings – Innovative, sustainable, and space-efficient living solutions designed for modern Australian living.",
                        "Property Maintenance – We deliver fast, dependable property maintenance to safeguard and grow the value of your real estate assets",
                        "Property Upgrades – Complete internal and external upgrades that transform ageing properties into modern, functional spaces.",
                        "Kitchen Upgrades – Contemporary kitchen renovations featuring practical layouts, quality finishes, finishes, and improved functionality.",
                        "Bathroom Upgrades – Stylish bathroom transformations designed to improve comfort, aesthetics, and long-term property value."
                    ],
                    "image_position": "right",
                    "image_scale": 1,
                    "image": {
